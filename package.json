{
  "name": "create-kit-dev",
  "version": "1.1.56",
  "description": "Fast Node.js + TypeScript project generator with esbuild, native testing, simple test scaffolding, optional dependency injection, and a zero-config developer workflow.",
  "type": "module",
  "main": "dist/bundle.cjs",
  "source": "src/main.ts",
  "bin": {
    "create-kit-dev": "dist/bundle.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosfrancomarinho/kit-dev.git"
  },
  "author": "marcosmarinho",
  "license": "MIT",
  "keywords": [
    "create-kit-dev",
    "kit-dev",
    "typescript",
    "typescript-7",
    "nodejs",
    "cli",
    "project-generator",
    "scaffolding",
    "starter-kit",
    "typescript-starter",
    "node-starter",
    "backend-starter",
    "esbuild",
    "node-test",
    "testing",
    "test-generator",
    "test-runner",
    "ast",
    "dependency-injection",
    "di-container",
    "developer-tools",
    "zero-config",
    "watch-mode",
    "type-checking",
    "micro-editor",
    "terminal-editor",
    "minimal",
    "lightweight",
    "framework-agnostic",
    "architecture-agnostic"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/bundle.cjs",
    "dev": "node kit-dev/build/dev.cjs",
    "build": "node kit-dev/build/esbuild.config.cjs",
    "type": "node kit-dev/build/type.cjs",
    "test": "node kit-dev/test/test.cjs",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  },
  "files": [
    "dist/bundle.cjs",
    "dist/bundle.cjs.map",
    "src/templates/files"
  ]
}
